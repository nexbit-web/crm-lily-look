# Змінні CRM LILY LOOK. Скопіюйте у .env (локально) або внесіть у Vercel →
# Project → Settings → Environment Variables (Production). Значень тут немає
# навмисно — секрети живуть лише в .env і у Vercel.

# ── Обовʼязкові ──────────────────────────────────────────────────────────────

# Neon → Connection string, варіант «Pooled connection» (хост із -pooler).
DATABASE_URL=

# Підпис cookie сесій. Згенерувати: openssl rand -base64 32
# Без нього CRM не стартує. Зміна секрету розлогінює всіх.
BETTER_AUTH_SECRET=

# Адреса CRM у продакшені, напр. https://crm.lilylook.ua
# Локально не задавати — береться з адреси запиту.
BETTER_AUTH_URL=

# Cloudinary → Dashboard → API Keys. API_SECRET лишається на сервері.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Папка для фото товарів (за замовчуванням lily-look/products).
CLOUDINARY_FOLDER=

# ── Кеш (дуже бажано: без нього кожен перегляд будить базу) ──────────────────

# Upstash → Database → REST API. Через Vercel Marketplace змінні звуться
# KV_REST_API_URL / KV_REST_API_TOKEN — підходять і вони.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Нові замовлення в реальному часі (без них CRM працює, просто без сповіщень) ──

# Pusher → Channels → App Keys. Кластер — eu.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# Секрет вебхука POST /api/hooks/orders — той самий має бути на сайті.
# Згенерувати: openssl rand -hex 32
CRM_HOOK_SECRET=
