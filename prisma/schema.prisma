// CRM LILY LOOK — схема бази даних (Neon Postgres)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/lib/server/prisma-client"
}

datasource db {
  provider = "postgresql"
}

// ─── Каталог ────────────────────────────────────────────────────────────────

model Category {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  /// Обкладинка категорії для вітрини /catalog. Заповнює CRM при створенні
  /// категорії; без неї плитка показує заглушку.
  imageUrl String?
  position Int     @default(0)

  // Самопосилання дозволяє робити підкатегорії ("Сукні → Вечірні")
  // без зміни схеми.
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  products  Product[]
  discounts DiscountCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId, position])
}

model Product {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String
  /// Базова ціна в копійках — та, що без знижок. Знижки її не чіпають.
  price       Int
  /// Ціна до сплати після знижок, у копійках.
  ///
  /// Рахує тригер у БД (`lily_recompute_prices`), тому колонка однакова для
  /// сайту і для CRM — писати в неї вручну не треба. Знижка діє, коли
  /// finalPrice < price: саме за цією умовою працюють фільтр «Знижки»
  /// й закреслена стара ціна.
  finalPrice  Int    @default(0)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  images       ProductImage[]
  variants     ProductVariant[]
  measurements ProductMeasurement[]
  attributes   ProductAttribute[]
  discounts    DiscountProduct[]

  /// Вимикач моделі в CRM: false — товару на сайті немає взагалі.
  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, isActive])
  @@index([isActive, createdAt])
  @@index([isActive, finalPrice])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int     @default(0)

  /// Колір, якому належить фото — написання те саме, що в ProductVariant.color
  /// (FK немає, звʼязок за текстом). NULL — спільне фото товару: сайт показує
  /// його за будь-якого вибраного кольору.
  color String?

  @@index([productId, position])
  @@index([productId, color, position])
}

/// Конкретна одиниця товару: розмір + колір. Саме варіант має залишок і SKU,
/// саме варіант потрапляє в кошик і замовлення.
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku        String  @unique
  size       String
  color      String
  colorHex   String?
  /// Базова ціна в копійках, якщо відрізняється від Product.price
  /// (напр. XXL дорожчий). NULL — беремо ціну товару.
  price      Int?
  /// Ціна варіанта після знижок. NULL, коли немає власної ціни — тоді
  /// діє Product.finalPrice. Рахує той самий тригер, що й для товару.
  finalPrice Int?
  /// Скільки одиниць саме цього розміру й кольору на складі.
  /// 0 — розмір зникає з сайту; коли нуль у всіх варіантів,
  /// товар зникає з каталогу, але сторінка лишається доступною.
  stock      Int     @default(0)
  /// Вимикач конкретного розміру/кольору в CRM.
  isActive   Boolean @default(true)

  cartItems CartItem[]

  @@unique([productId, size, color])
  @@index([productId])
  @@index([productId, isActive, stock])
}

/// Заміри готового виробу в сантиметрах — один рядок на розмір.
///
/// Живуть окремо від ProductVariant навмисно: варіант — це пара «розмір +
/// колір» із власним залишком, а заміри від кольору не залежать, і дублювати
/// їх у кожному кольорі не було б сенсу. Сайт підбирає рядок за `size`, тому
/// написання розміру мусить збігатися з ProductVariant.size.
model ProductMeasurement {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// "XS", "M", "46" — те саме значення, що й у варіанта.
  size String
  /// Український (європейський) відповідник. Текст, бо це часто діапазон
  /// ("40–42"), а не одне число.
  ua   String?

  /// Обхват грудей виробу в розкладеному вигляді, см.
  chest  Int?
  /// Довжина рукава, см.
  sleeve Int?
  /// Довжина виробу, см.
  length Int?

  /// Порядок рядків у таблиці: XS має йти перед XL, а не за алфавітом.
  position Int @default(0)

  @@unique([productId, size])
  @@index([productId, position])
}

/// Характеристика товару — рядок таблиці «Склад», «Посадка», «Сезон»…
///
/// Пара «назва + значення» замість окремих колонок: набір характеристик
/// у різних категорій різний, і додавати колонку заради однієї моделі не
/// варто. Порядок у картці задає `position`.
///
/// Таблицю створив сайт; CRM лише читає й пише в неї.
model ProductAttribute {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Назва характеристики: «Склад», «Посадка», «Сезон», «Країна виробництва».
  name  String
  /// Значення довільним текстом: «95% віскоза, 5% еластан».
  value String

  /// Порядок рядків у картці товару.
  position Int @default(0)

  // Одна характеристика з такою назвою на товар — інакше в картці
  // з'явилося б два «Складу» з різним текстом.
  @@unique([productId, name])
  @@index([productId, position])
}

// ─── Знижки ─────────────────────────────────────────────────────────────────

/// На що поширюється правило знижки.
enum DiscountScope {
  /// Весь каталог.
  ALL
  /// Обрані категорії (таблиця DiscountCategory).
  CATEGORY
  /// Обрані товари, хоч один (таблиця DiscountProduct).
  PRODUCT
}

/// Правило знижки — єдине джерело правди про ціну.
///
/// CRM створює правило й вмикає його прапорцем `isActive`; підсумкову ціну
/// перераховує тригер у БД. Правил може бути кілька одночасно — виграє те,
/// що дає покупцеві найнижчу ціну (знижки не додаються одна до одної).
///
/// Задається або `percent`, або `amount` — не обидва (перевіряє CHECK у БД).
model Discount {
  id      String        @id @default(cuid())
  name    String
  scope   DiscountScope
  /// Відсоток знижки, 1..90.
  percent Int?
  /// Фіксована знижка в копійках.
  amount  Int?

  isActive Boolean @default(false)

  categories DiscountCategory[]
  products   DiscountProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model DiscountCategory {
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([discountId, categoryId])
  @@index([categoryId])
}

model DiscountProduct {
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([discountId, productId])
  @@index([productId])
}

// ─── Кошик ──────────────────────────────────────────────────────────────────

/// Кошик живе на сервері й ідентифікується httpOnly-кукою.
/// Ціни завжди перераховуються з БД, тому клієнт не може їх підробити.
model Cart {
  id    String     @id @default(cuid())
  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id     String @id @default(cuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  quantity Int @default(1)

  @@unique([cartId, variantId])
  @@index([cartId])
}

// ─── Замовлення ─────────────────────────────────────────────────────────────

enum OrderStatus {
  NEW
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum DeliveryMethod {
  NOVA_POSHTA_BRANCH
  NOVA_POSHTA_COURIER
  UKRPOSHTA_BRANCH
  PICKUP
}

model Order {
  id     String      @id @default(cuid())
  /// Людиночитний номер для клієнта й менеджера, напр. "LL-2K4F7B".
  number String      @unique
  status OrderStatus @default(NEW)

  customerName  String
  customerPhone String
  customerEmail String?

  deliveryMethod  DeliveryMethod
  /// Адреса зберігається текстом — накладні не створюємо, менеджеру
  /// потрібні лише назва населеного пункту й відділення.
  deliveryCity    String?
  deliveryAddress String?
  comment         String?

  /// Усі суми — в копійках, зафіксовані на момент оформлення.
  subtotal     Int
  deliveryCost Int @default(0)
  total        Int

  paymentStatus   PaymentStatus @default(UNPAID)
  /// Ідентифікатор провайдера оплати ("manual", "stripe", "liqpay"…).
  paymentProvider String        @default("manual")
  /// Ідентифікатор транзакції у провайдера.
  paymentRef      String?

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

/// Позиція замовлення — денормалізований знімок товару.
/// Якщо товар пізніше перейменують, подорожчають або видалять,
/// замовлення залишиться історично точним.
model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Посилання на варіант без FK: варіант може зникнути, замовлення — ні.
  variantId   String?
  sku         String
  productName String
  productSlug String
  size        String
  color       String
  imageUrl    String?

  /// Ціна за одиницю в копійках на момент замовлення.
  unitPrice Int
  quantity  Int

  @@index([orderId])
}

// ─── Авторизація (better-auth) ──────────────────────────────────────────────
//
// Моделі згенеровані `@better-auth/cli generate` — назви полів і таблиць
// диктує better-auth, змінювати їх не можна. Таблиці окремі від магазину:
// user / session / account / verification.
//
// SQL для цих чотирьох таблиць лежить у prisma/sql/better-auth.sql —
// застосуйте його до Neon вручну (магазинні таблиці він не чіпає).

/// Співробітник, що входить у CRM. До покупців магазину не має стосунку.
model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  /// ADMIN | MANAGER — рядок, бо better-auth не працює з enum-полями.
  role          String?   @default("MANAGER")
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

/// Тут лежить хеш пароля (`password`) для входу через email+пароль.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
